<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for the bundled Node runtime (Pi Agent Server.app) under the
  hardened runtime that notarization requires. They mirror the set the official
  Node.js macOS build ships with (tools/osx-entitlements.plist):
  - V8 needs JIT and writable executable memory;
  - pi plugins and npx tools load native addons that are not signed by our team;
  - user tooling may rely on DYLD_* variables.
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-executable-page-protection</key>
    <true/>
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
  </dict>
</plist>
